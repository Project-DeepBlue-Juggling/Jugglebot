# Timed target state (trajectory_node, TRAJECTORY mode only).
# Reach a pose+orientation at a nominal linear velocity at an ABSOLUTE arrival time.
# The arrival lead is a HARD timing constraint: a too-tight request is rejected
# loudly (accepted=false, TOO_FAST) with the minimal feasible lead — it is NEVER
# silently slowed to arrive late. Validated through the single feasibility gate.

geometry_msgs/Pose pose            # Target pose. Position mm, z STOW-relative (170 = ACTIVE).
                                   # Orientation quaternion (converted to a rotvec internally).
geometry_msgs/Vector3 velocity_mm_s  # Linear velocity at arrival (mm/s). Zero => arrive at rest.
builtin_interfaces/Time arrival_time  # Absolute arrival time (ROS clock; converted to the
                                   # perf_counter emitter domain at the ONE conversion point).
bool hold_after                    # True  => decel to rest and HOLD at the target after arrival.
                                   # False => after arriving (and coming to rest), profile back
                                   #          to the neutral active pose (0,0,170,0,0,0) and hold.
---
bool accepted                      # True iff the timed plan was planned and installed.
string code                        # Feasibility code: OK / UNREACHABLE / WORKSPACE / LIMIT_VEL /
                                   # LIMIT_ACC / LIMIT_JERK / TOO_FAST / STEP_BOUND / WRONG_MODE / STALE_STATE.
string message                     # Human-readable detail (populated on both accept and reject).
float64 planned_duration_s         # The arrival lead actually used (s).
float64 min_duration_s             # Minimal feasible arrival lead at the current limits
                                   # (populated on a TOO_FAST rejection so the caller can retry achievably).
