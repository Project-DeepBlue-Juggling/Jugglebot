.DS_Store
Thumbs.db

# Virtual environment
venv/
env/
.venv/

# Build output
build/
dist/

# Dependency directories
node_modules/
jspm_packages/

# Log files
*.log

# Others
*.bak
*.tmp

# Ignore build and install folders
build/
install/
log/

# Ignore Python bytecodes and cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyd
.pytest_cache/
.hypothesis/
*.egg-info/
.mypy_cache/

# Ignore specific ROS generated files
.rviz/
*.user

# Ignore package-specific build directories
*/*/build/
*/*/build_isolated/
*/*/devel/
*/*/devel_isolated/
*/*/logs/
tools/logs/

# Ignore generated CMake files
CMakeLists.txt.user
CMakeCache.txt
CMakeFiles/

# Ignore generated by colcon
log/
.colcon/

# Ignore files created by package managers
/rosdep/
/rosinstall/
*.mcap
*.csv
# Committed test fixtures decoded from bags (hand-jam event, 2026-10-04) are the
# one CSV class that MUST ship: the test fails by name without them.
!tests/motion/fixtures/*.csv
# The frozen Item-ID crosswalk (plan item-id-per-kind P4): its presence is what
# switches mapkit to per-kind IDs, so every clone must carry it.
!mapkit/legacy_ids.csv
# Wave Camera bench captures (tools/wave_console.py --out) are evidence cited by
# ros_ws/docs/wave_camera_findings.md, so they ship despite the *.log rule above.
!ros_ws/src/jugglebot/WaveCamera_ESP_code/bench_logs/*.log
**/metadata.yaml
*.qtm
experimenting/Juggling Analysis Tool/data/5_ball_juggling_cut_balls_only.tsv
Ball Butler/.$Circuit Diagram.drawio.bkp
Ball Butler/ball_butler_circuit_diagram/\#auto_saved_files\#
Ball Butler/hand_sensor_pcb_rail/PCB Rail.dxf
/Ball Butler/hand_sensor_pcb_rail/hand_sensor_pcb_rail-backups
/Ball Butler/ball_butler_circuit_diagram/ball_butler_circuit_diagram-backups
Ball Butler/hand_sensor_pcb_rail/fp-info-cache
/Ball Butler/zTesting/throw_testing/accuracy_testing/.venv
/.claude/*
!/.claude/commands/
!/.claude/agents/
!/.claude/workflows/
temp/*
# temp/runtime/ (ignored by temp/* above, and NOTHING may re-include it) holds
# the copies the running robot writes: temp/runtime/records.md and
# temp/runtime/learn/<plant_id>/memory_v2.csv, each with a .seed JSON. Seeded
# from the tracked files below and merged back at the Sitting debrief
# (tools/runtime_records.py), so a running launch leaves `git status` empty
# (Phase C8, plans/active/night-shift-closeout.md; ros_ws/src/jugglebot/
# jugglebot/runtime_paths.py; pinned by tests/ros/test_runtime_writes_untracked.py).
#
# The skill-stack learner memory is the one artifact under temp/ that is
# tracked: it is the robot's accumulated learning and had no off-box copy.
# The robot never writes it directly (above); the debrief commits it.
!temp/learn/
temp/learn/*
# Every plant_id's memory.csv (one directory per plant_id / Sitting rung,
# e.g. temp/learn/oval-h050/): the file itself is tracked, nothing else.
!temp/learn/*/
temp/learn/*/*
!temp/learn/*/memory.csv
# Since the learner-generalisation merge (2026-11-06) the LIVE Memory is the
# schema-v2 file; memory.csv is frozen (the migration test's fixture). The live
# plant's v2 file is tracked and committed at each Sitting debrief (owner,
# 2026-11-06); other plants' v2 files stay local.
!temp/learn/jugglebot/memory_v2.csv

# MuJoCo generated log (appears on GLFW/headless errors)
MUJOCO_LOG.TXT

# PlatformIO build trees for the three Teensy sketches. The bare `build/` rule
# above already covers .pio/build/, but not .pio/libdeps/ (fetched libraries) or
# .pio/patched_ld/ (the generated linker script) — both are build artefacts.
.pio/

# MkDocs build output
site/

# wayfinder maps (local-markdown tracker; decisions collapse into plans/active/ when a map clears)
.scratch/
